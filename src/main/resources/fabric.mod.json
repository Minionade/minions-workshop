{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "A modular workshop with four crafting, smelting or storage units.",
  "authors": ["Minionade"],
  "contributors": ["Modmuss50", "EwyBoy", "JorVa", "Vswe"],
  "contact": {
    "homepage": "https://github.com/Minionade/minions-workshop",
    "sources": "https://github.com/Minionade/minions-workshop",
    "issues": "https://github.com/Minionade/minions-workshop/issues"
  },
  "license": "MIT",
  "icon": "assets/minions_workshop/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.minionade.workshop.fabric.WorkshopFabric"],
    "client": ["dev.minionade.workshop.fabric.WorkshopFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
